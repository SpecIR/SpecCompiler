@startebnf
title SpecCompiler: Attributes (spec_attribute_values)
(* A blockquote becomes an attribute when its FIRST paragraph starts with *)
(* Key followed by colon AND Key is a declared attribute of the enclosing *)
(* object's type (own or inherited, case-insensitive). Otherwise it is *)
(* plain prose. One blockquote declares ONE attribute; every later line or *)
(* block of the same blockquote continues the value. Specification-level *)
(* blockquotes (under the H1) accept any key, with a warning for keys not *)
(* declared on the specification's type. *)

spec_attribute_value = ">", AttrPara, { ContinuationBlock };

(* > key: value — Key matches [A-Za-z_][A-Za-z0-9_]* and must be declared *)
AttrPara = Key, ":", Value;

(* Later blocks — including key:-shaped lines — extend the value *)
ContinuationBlock = Paragraph | BulletList | OrderedList | Table;

@endebnf
