#!/bin/false
# scripts/versions.env — pinned dependency versions for SpecCompiler Core
# Sourced by: build-extensions.sh, install-native.sh, Dockerfile
# DO NOT execute directly.

# ---------------------------------------------------------------------------
# Deno  (optional renderer host: model-owned charts, e.g. abnt)
# ---------------------------------------------------------------------------
DENO_VERSION="2.6.4"

# ---------------------------------------------------------------------------
# PlantUML  (optional: puml floats)
# ---------------------------------------------------------------------------
PLANTUML_VERSION="1.2024.8"

# ---------------------------------------------------------------------------
# SQLite  (WASM bundle for the HTML web app search/filters/inspector)
# ---------------------------------------------------------------------------
SQLITE_VERSION="3470200"
SQLITE_YEAR="2024"

# ---------------------------------------------------------------------------
# Native Lua C extensions
# ---------------------------------------------------------------------------
LSQLITE3_VERSION="v0.9.6"
LUV_TAG="1.48.0-2"
LUAZIP_TAG="v0.2.0"
AMATH_COMMIT="1b9e2f1ae31354fc62b8843b7c408edb4e33f3d3"

# ---------------------------------------------------------------------------
# Pure Lua libraries
# ---------------------------------------------------------------------------
DKJSON_VERSION="2.8"
SHA2_COMMIT="6adac177c16c3496899f69d220dfb20bc31c03df"
SLAXML_TAG="v0.8"

# ---------------------------------------------------------------------------
# Windows native build (windows/build.ps1)
# ---------------------------------------------------------------------------
# Shared Lua runtime used by source-built Pandoc and the DLL modules.
LUA_VERSION="5.4.7"
# Builds the luaamath parser generator (leg) from source on Windows.
PEG_VERSION="0.1.18"
# Pandoc source release bundled in the Windows distribution.
# 3.12 changed DOCX bookmark naming (all names now start with "_"), which
# SpecCompiler's raw OOXML bookmarks do not follow yet: stay on 3.11.
PANDOC_WIN_VERSION="3.11"
ZLIB_WIN_VERSION="1.3.1"
LIBZIP_WIN_VERSION="1.11.4"
# Coverage library shipped with the test suite.
LUACOV_VERSION="0.15.0"
# Bundled MIT build of PlantUML (checksum of plantuml-mit-<PLANTUML_VERSION>.jar)
PLANTUML_WIN_SHA256="404c835cf6902246e4b15e0d95acb01bf31e048b141be1ccf68f5ca22c9cba64"
